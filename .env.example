# Supabase Edge Functions secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# GitHub provisioning
GITHUB_TOKEN=replace-with-fine-grained-token
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-repository
GITHUB_BRANCH=main

# Web Push
VAPID_PUBLIC_KEY=replace-with-public-key
VAPID_PRIVATE_KEY=replace-with-private-key
VAPID_SUBJECT=https://your-domain.example
